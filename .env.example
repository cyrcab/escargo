# Base de données (docker compose local)
DATABASE_URL=postgres://escargo:escargo@localhost:5432/escargo
REDIS_URL=redis://localhost:6379

# API
API_PORT=3000
JWT_SECRET=change-me

# Auth (Sign in with Apple / Google)
APPLE_CLIENT_ID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=

# Données transport
# À récupérer sur data.gouv.fr (jeu "Horaires SNCF")
SNCF_GTFS_URL=https://eu.ftp.opendatasoft.com/sncf/plandata/Export_OpenData_SNCF_GTFS_NewTripId.zip
SNCF_GTFS_RT_URL=https://proxy.transport.data.gouv.fr/resource/sncf-gtfs-rt-trip-updates
# GTFS Île-de-France Mobilités (RER, Transilien), public, sans clé
IDFM_GTFS_URL=https://eu.ftp.opendatasoft.com/stif/GTFS/IDFM-gtfs.zip
# Clé PRIM (compte sur prim.iledefrance-mobilites.fr) : temps réel RER et Transilien.
# Jamais committée. Vide : le worker tourne sans temps réel Île-de-France.
PRIM_API_KEY=
PRIM_ESTIMATED_TIMETABLE_URL=https://prim.iledefrance-mobilites.fr/marketplace/estimated-timetable
NAVITIA_TOKEN=
